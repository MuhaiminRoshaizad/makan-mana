<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12: the reels on ink, where Android 12's splash puts its
     icon, so Flutter's first frame matches it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ink" />
    <item
        android:width="288dp"
        android:height="288dp"
        android:drawable="@drawable/splash_reels"
        android:gravity="center" />
</layer-list>
