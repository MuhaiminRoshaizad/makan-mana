<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts: the reels on ink (drawable/launch_background). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter while it starts and runs. Ink, so nothing flashes
         between the splash and Flutter's first frame, which is ink too. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
